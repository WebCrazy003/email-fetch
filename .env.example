GMAIL_TEST_RECIPIENTS=
GMAIL_TEST_RECIPIENT=
GMAIL_DEFAULT_SENDER_NAME=Richard Wang
EMAIL_OPT_OUT_TEXT=To opt out of future emails, reply with "unsubscribe".
EMAIL_SEND_DAILY_LIMIT=100
EMAIL_SEND_HOURLY_LIMIT=20
EMAIL_SEND_DELAY_SECONDS=5
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
API_ORIGIN=http://127.0.0.1:3000
LOG_LEVEL=info
